[Unit]
Description=Agentic Trading self-upgrade (one change: Codex writes, Claude reviews, walls and tests decide)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/home/doczeus/.local/bin/agentic-trading-upgrade
# the steps time out on their own (~158 min in all); systemd must never stop a run mid-deploy
TimeoutStartSec=240min
Nice=10
StandardOutput=append:/home/doczeus/Projects/Agnetic TraDING/data/state/upgrade.log
StandardError=append:/home/doczeus/Projects/Agnetic TraDING/data/state/upgrade.log
