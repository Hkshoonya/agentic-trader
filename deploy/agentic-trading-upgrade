#!/bin/sh
# Launcher for the self-upgrader's run unit: the project path contains a space,
# which systemd's ExecStart parser handles poorly, so the cd lives here. Codex is
# installed under nvm, which the systemd user PATH does not include.
set -e
for bin in "$HOME"/.nvm/versions/node/*/bin; do [ -d "$bin" ] && PATH="$bin:$PATH"; done
export PATH="$HOME/.local/bin:$PATH"
# DEEPSEEK_API_KEY for the second writer, if the operator has given one (mode 600, never in the repo).
env_file="$HOME/.config/agentic-trading/upgrade.env"
if [ -r "$env_file" ]; then set -a; . "$env_file"; set +a; fi
cd "/home/doczeus/Projects/Agnetic TraDING"
# Then tell the operator how the night went on their own screen; no desktop just means no notice,
# and the run's own exit code stands either way.
status=0
out=$(".venv/bin/agentic-trading" upgrade run --config config/agentic.toml 2>&1) || status=$?
printf '%s\n' "$out"
urgency=normal; [ "$status" -eq 0 ] || urgency=critical
notify-send -u "$urgency" "Agentic self-upgrade" "$(printf '%s' "$out" | tail -n 3 | cut -c1-300)" 2>/dev/null || true
exit "$status"
